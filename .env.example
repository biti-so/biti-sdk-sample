# Biti backend (Frappe). The server calls /partner/v1/* here, and pages load the SDK from here.
BITI_BASE_URL=http://192.168.100.200:8004
# Biti wallet web app. The SDK sends browser users here to pay (/pay/<order_id>).
BITI_WALLET_URL=http://192.168.100.200:8052
# From the Mini App record in Biti Desk. Keep the secret on the server only.
BITI_CLIENT_ID=
BITI_CLIENT_SECRET=
# Origins of this app. They must also be in the Mini App's Allowed Origins.
APP_ORIGINS=http://192.168.100.200:8090,http://localhost:8090
PORT=8090
# Any long random string. It signs the session cookie.
SESSION_SECRET=
