# Biti API. Production: BITI_BASE_URL=https://bitiwallet.easytouch.cloud
# Dev example: BITI_BASE_URL=http://192.168.100.119:8004
BITI_BASE_URL=https://bitiwallet.easytouch.cloud
# Biti web app origin, used by the SDK (data-biti-origin).
# Dev example: BITI_WALLET_URL=http://192.168.100.119:8052
BITI_WALLET_URL=https://bitiwallet.easytouch.cloud
# From the Mini App in Biti Desk. Server only.
BITI_CLIENT_ID=
BITI_CLIENT_SECRET=
# Mini App id, used by the "Open in Biti" link. Default daryeel-stays.
BITI_APP_ID=daryeel-stays
# Any long random string. It signs the session cookie.
SESSION_SECRET=
# Origins of this app, comma separated. Also add them to the Mini App's Allowed Origins.
# Dev example: APP_ORIGINS=http://192.168.100.119:8090,http://localhost:8090
APP_ORIGINS=https://stays.example.com
# anywhere (default) or biti_only
RUN_MODE=anywhere
# 1 turns on the playground and /api/dev/log. Leave off in production.
# DEV_TOOLS=1
# Default 8090.
# PORT=8090
# Default data/daryeel.sqlite.
# DB_PATH=data/daryeel.sqlite
# 1 in production (HTTPS): adds Secure to the session cookie.
# COOKIE_SECURE=1
# 1 behind a reverse proxy (Python server): trust X-Forwarded-* for return URLs.
# TRUST_PROXY=1
